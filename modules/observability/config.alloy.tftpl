// Managed by Terraform (modules/observability). FortiGate syslog (RFC5424) -> Cockpit logs.

loki.relabel "syslog" {
  forward_to = []

  rule {
    source_labels = ["__syslog_message_hostname"]
    target_label  = "host"
  }
  rule {
    source_labels = ["__syslog_message_severity"]
    target_label  = "level"
  }
}

loki.source.syslog "fortigate" {
  listener {
    address       = "${ip}:514"
    protocol      = "udp"
    syslog_format = "rfc5424"
    labels        = { job = "fortigate" }
  }
  listener {
    address       = "${ip}:514"
    protocol      = "tcp"
    syslog_format = "rfc5424"
    labels        = { job = "fortigate" }
  }

  relabel_rules = loki.relabel.syslog.rules
  forward_to    = [loki.process.fortigate.receiver]
}

// FortiGate leaves the syslog APP-NAME empty: the log type (event, traffic,
// utm) comes from the message. The traffic log is by far the largest volume:
// dropped unless keep_traffic_log.
loki.process "fortigate" {
  stage.regex {
    expression = "type=\"(?P<type>[a-z-]+)\""
  }
  stage.labels {
    values = { type = "" }
  }
%{ if !keep_traffic_log ~}
  stage.match {
    selector = "{type=\"traffic\"}"
    action   = "drop"
  }
%{ endif ~}

  forward_to = [loki.write.cockpit.receiver]
}

loki.write "cockpit" {
  endpoint {
    url     = "${push_url}"
    headers = { "X-Token" = sys.env("COCKPIT_TOKEN") }
  }
}

# Copy to policy.yaml (same folder) to extend the firewall policy. main.tf reads
# it. Apply pushes changes live to the FGCP primary, with no rebuild.
#
# Ordering: rules are evaluated top-down, first match wins (quick rules). Your
# rules render before the defaults ([EW] inter-spoke block, [HUB] one per hub
# endpoint, [EGRESS]), so an exception to the inter-spoke block works as written.
# Nothing else is open: on-prem flows (ONPREM_VPN) need rules of yours. Rule
# descriptions must be unique and contain no <, > or &.
#
# aliases: name -> CIDRs. Built-in aliases usable in rules: SPOKE_NETS,
# HUB_EGRESS_NET, ONPREM_VPN, EGRESS_PGWS, internal_nets.
#
# rules: action pass|block, interface hub (default)|egress, protocol
# any|tcp|udp|icmp, state sloppy (default)|keep, optional port / port_end
# (tcp and udp only). source / destination: alias, CIDR or any.
#
# nat_outbound is not supported on FortiGate. The [EGRESS] rule SNATs the
# spokes to the egress data VIP.
#
# aliases:
#   SPOKE_GENOMIC: ["10.96.8.0/21"] # Private of the spoke with index 1
#   SPOKE_HR: ["10.96.16.0/21"]     # Private of the spoke with index 2
#   (a spoke's CIDRs: terraform output spokes)
# rules:
#   - description: "Genomic reaches HR over HTTPS"
#     action: pass
#     source: SPOKE_GENOMIC
#     destination: SPOKE_HR
#     protocol: tcp
#     port: 443
#   - description: "On-prem reaches genomic over HTTPS"
#     action: pass
#     source: ONPREM_VPN
#     destination: SPOKE_GENOMIC
#     protocol: tcp
#     port: 443

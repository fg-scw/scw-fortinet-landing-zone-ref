# Copy to terraform.tfvars (never committed). Options are in variables.tf and in
# the modules/*/variables.tf files that main.tf passes through.

# Public IPs allowed on the bastion, including the machine running Terraform. It
# checks new firewalls and pushes the policy through the bastion.
admin_cidrs           = ["203.0.113.10/32"]
admin_ssh_public_keys = ["ssh-ed25519 AAAA_REPLACE_ME admin@example"]

# Also allow admin_cidrs to reach each firewall on its Public Gateway IP (SSH 2222,
# WebUI 8443). Off: through the bastion only.
# admin_direct_access = true

# Factory FortiOS KVM snapshot of each zone (README, step 1) and license file of
# each node (.lic, never committed). The node zones also set the zones of the
# Public Gateways and VPN gateways.
firewall = {
  instance_type = "POP2-2C-8G"
  nodes = {
    fw1 = { zone = "fr-par-1", snapshot_id = "fr-par-1/<uuid>", license_file = "licenses/fw1.lic" }
    fw2 = { zone = "fr-par-2", snapshot_id = "fr-par-2/<uuid>", license_file = "licenses/fw2.lic" }
  }
}

# Spokes. index (0-1023) sets the spoke CIDRs (Pub /22 from 10.64.0.0/12, Private
# /21 from 10.96.0.0/11). Do not change it once the spoke is live.
spokes = {
  genomic = {
    index         = 1
    hybrid_bypass = false # true: Private VPC peered with Interlink, no firewall
    nacl_inbound = [
      { to = "private", source = "10.0.4.0/24", port = 8080, description = "Hub load balancers to genomic backends" },
    ]
  }
}

# Public endpoints: Edge Services (TLS, WAF) in front of Load Balancers in the
# owner's network.
endpoints = {
  web = {
    owner = "genomic"
    config = {
      zones   = ["fr-par-1", "fr-par-2"]
      backend = { server_ips = ["10.96.8.10", "10.96.8.11"], port = 8080, health_check_uri = "/healthz" }
      edge    = { fqdns = ["genomic.example.com"] }
    }
  }
}

# Syslog relay to Cockpit. Off when the customer has its own SIEM.
observability = true

# Edge Services subscription of the project, required by endpoints.
edge_services_plan = "starter"

